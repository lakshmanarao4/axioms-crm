@model IEnumerable<AcxiomCRM.Models.ViewModels.UserItemViewModel>
@{
    ViewData["Title"] = "User & Role Management";
    Layout = "_Layout";
    var roles = ViewBag.AvailableRoles as List<string> ?? new List<string>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-0"><i class="bi bi-person-gear text-primary me-2"></i>User & Role Administration</h3>
        <p class="text-muted small mb-0">Manage system accounts, assign RBAC security roles, unlock accounts, and reset credentials.</p>
    </div>
    <a asp-controller="Account" asp-action="Register" class="btn btn-primary rounded-pill px-3 shadow-sm">
        <i class="bi bi-person-plus-fill me-1"></i> Provision New User
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>User Profile</th>
                        <th>Email / Username</th>
                        <th>Assigned Role</th>
                        <th>Account Status</th>
                        <th>Lockout Status</th>
                        <th>Failed Attempts</th>
                        <th class="text-end">Administrative Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@u.FullName</div>
                                <div class="small text-muted font-monospace">@u.Id</div>
                            </td>
                            <td>
                                <div><i class="bi bi-envelope text-muted me-1"></i>@u.Email</div>
                                <div class="small text-muted">Created: @u.CreatedDate.ToString("MMM dd, yyyy")</div>
                            </td>
                            <td>
                                <!-- Role Change Dropdown/Form -->
                                <form asp-action="ChangeRole" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@u.Id" />
                                    <div class="input-group input-group-sm" style="max-width: 170px;">
                                        <select name="newRole" class="form-select form-select-sm" onchange="this.form.submit()">
                                            @foreach (var r in roles)
                                            {
                                                <option value="@r" selected="@(u.Role == r)">@r</option>
                                            }
                                        </select>
                                    </div>
                                </form>
                            </td>
                            <td>
                                @if (u.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Deactivated</span>
                                }
                            </td>
                            <td>
                                @if (u.IsLockedOut)
                                {
                                    <span class="badge bg-danger"><i class="bi bi-lock-fill me-1"></i>Locked Out</span>
                                    <div class="small text-danger">Until: @u.LockoutEnd?.LocalDateTime.ToString("HH:mm:ss")</div>
                                }
                                else
                                {
                                    <span class="badge bg-light text-success border"><i class="bi bi-unlock-fill me-1"></i>Unlocked</span>
                                }
                            </td>
                            <td>
                                <span class="badge @(u.AccessFailedCount > 0 ? "bg-warning text-dark" : "bg-light text-muted border")">
                                    @u.AccessFailedCount / 5
                                </span>
                            </td>
                            <td class="text-end">
                                <!-- Unlock Button -->
                                @if (u.IsLockedOut || u.AccessFailedCount > 0)
                                {
                                    <form asp-action="Unlock" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@u.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-warning text-dark" title="Unlock Account">
                                            <i class="bi bi-unlock"></i> Unlock
                                        </button>
                                    </form>
                                }

                                <!-- Toggle Active/Inactive -->
                                <form asp-action="ToggleActive" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@u.Id" />
                                    <button type="submit" class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")" title="@(u.IsActive ? "Deactivate" : "Activate")">
                                        <i class="bi @(u.IsActive ? "bi-person-x" : "bi-person-check")"></i>
                                    </button>
                                </form>

                                <!-- Password Reset Modal Trigger -->
                                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#resetPassModal-@u.Id" title="Reset Password">
                                    <i class="bi bi-key"></i>
                                </button>

                                <!-- Reset Password Modal -->
                                <div class="modal fade text-start" id="resetPassModal-@u.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <form asp-action="ResetPassword" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@u.Id" />
                                                <div class="modal-header">
                                                    <h5 class="modal-title">Reset Password for @u.Email</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <div class="mb-3">
                                                        <label class="form-label small fw-semibold">New Password</label>
                                                        <input type="password" name="newPassword" class="form-control" placeholder="••••••••" required />
                                                        <div class="form-text small">Must be at least 8 characters with upper, lower, number, and symbol.</div>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-primary btn-sm">Reset Password</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
