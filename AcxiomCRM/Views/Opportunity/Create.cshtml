@model AcxiomCRM.Models.ViewModels.OpportunityViewModel
@{
    ViewData["Title"] = "New Opportunity";
    Layout = "_Layout";
    var todayStr = DateTime.UtcNow.ToString("yyyy-MM-dd");
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0"><i class="bi bi-graph-up text-primary me-2"></i>Create New Opportunity</h5>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to List</a>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post" id="oppForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="OpportunityName" class="form-label fw-semibold small">Opportunity / Deal Name <span class="text-danger">*</span></label>
                            <input asp-for="OpportunityName" class="form-control" placeholder="e.g. Enterprise Cloud Modernization" />
                            <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label fw-semibold small">Associated Customer <span class="text-danger">*</span></label>
                            <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select">
                                <option value="">-- Select Customer --</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LeadId" class="form-label fw-semibold small">Originating Lead (Optional)</label>
                            <select asp-for="LeadId" asp-items="ViewBag.Leads" class="form-select">
                                <option value="">-- No Linked Lead --</option>
                            </select>
                            <span asp-validation-for="LeadId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Amount" class="form-label fw-semibold small">Deal Amount ($) <span class="text-danger">*</span></label>
                            <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" placeholder="Must be > 0" id="oppAmount" />
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Probability" class="form-label fw-semibold small">Win Probability (%) <span class="text-danger">*</span></label>
                            <input asp-for="Probability" class="form-control" type="number" min="0" max="100" placeholder="0 - 100" id="oppProbability" />
                            <span asp-validation-for="Probability" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Stage" class="form-label fw-semibold small">Pipeline Stage <span class="text-danger">*</span></label>
                            <select asp-for="Stage" class="form-select" id="oppStage">
                                <option value="Qualification">Qualification</option>
                                <option value="Proposal">Proposal</option>
                                <option value="Negotiation">Negotiation</option>
                                <option value="Won">Won</option>
                                <option value="Lost">Lost</option>
                            </select>
                            <span asp-validation-for="Stage" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ExpectedCloseDate" class="form-label fw-semibold small">Expected Close Date <span class="text-danger">*</span></label>
                            <input asp-for="ExpectedCloseDate" class="form-control" type="date" min="@todayStr" id="oppCloseDate" />
                            <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="AssignedTo" class="form-label fw-semibold small">Opportunity Owner</label>
                            <input asp-for="AssignedTo" class="form-control" placeholder="rep@acxiomcrm.com" />
                            <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="border-top mt-4 pt-3 d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Save Opportunity
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
