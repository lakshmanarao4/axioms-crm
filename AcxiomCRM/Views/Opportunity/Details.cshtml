@model AcxiomCRM.Models.Entities.Opportunity
@{
    ViewData["Title"] = "Opportunity Details";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-0">@Model.OpportunityName</h3>
        <p class="text-muted small mb-0">Deal ID #@Model.OpportunityId &bull; Created @Model.CreatedDate.ToString("MMMM dd, yyyy")</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.OpportunityId" class="btn btn-outline-primary btn-sm rounded-pill px-3">
            <i class="bi bi-pencil"></i> Edit Opportunity
        </a>
        <a asp-controller="FollowUp" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-primary btn-sm rounded-pill px-3">
            <i class="bi bi-calendar-plus"></i> Schedule Follow-Up
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white fw-bold"><i class="bi bi-graph-up me-2 text-primary"></i>Deal Financials & Pipeline</div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-sm-5 text-muted">Customer:</dt>
                    <dd class="col-sm-7 fw-semibold">
                        <a asp-controller="Customer" asp-action="Details" asp-route-id="@Model.CustomerId" class="text-decoration-none">
                            @(Model.Customer != null ? Model.Customer.CustomerName : "N/A")
                        </a>
                    </dd>

                    <dt class="col-sm-5 text-muted">Deal Amount:</dt>
                    <dd class="col-sm-7 fw-bold text-success fs-5">@Model.Amount.ToString("C0")</dd>

                    <dt class="col-sm-5 text-muted">Win Probability:</dt>
                    <dd class="col-sm-7">
                        <span class="fw-semibold">@Model.Probability%</span>
                    </dd>

                    <dt class="col-sm-5 text-muted">Weighted Value:</dt>
                    <dd class="col-sm-7 fw-semibold text-primary">@Model.WeightedValue.ToString("C0")</dd>

                    <dt class="col-sm-5 text-muted">Current Stage:</dt>
                    <dd class="col-sm-7">
                        <span class="badge @(Model.Stage == "Won" ? "bg-success" : Model.Stage == "Lost" ? "bg-danger" : "bg-primary")">
                            @Model.Stage
                        </span>
                    </dd>

                    <dt class="col-sm-5 text-muted">Expected Close Date:</dt>
                    <dd class="col-sm-7 fw-semibold">@Model.ExpectedCloseDate.ToString("MMMM dd, yyyy")</dd>

                    <dt class="col-sm-5 text-muted">Owner / Rep:</dt>
                    <dd class="col-sm-7">@Model.AssignedTo</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
