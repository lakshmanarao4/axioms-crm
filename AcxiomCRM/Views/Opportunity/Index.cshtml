@model IEnumerable<AcxiomCRM.Models.Entities.Opportunity>
@{
    ViewData["Title"] = "Opportunity Pipeline";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-0"><i class="bi bi-graph-up-arrow text-primary me-2"></i>Sales Opportunities</h3>
        <p class="text-muted small mb-0">Track active deals, pipeline stages, weighted values, and win probabilities.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-pill px-3 shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> New Opportunity
    </a>
</div>

<!-- Search & Stage Filter -->
<div class="card mb-4 border-0 shadow-sm">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5 col-lg-4">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Search opportunity, customer..." value="@ViewBag.CurrentSearch" />
                </div>
            </div>
            <div class="col-md-3 col-lg-3">
                <select name="stage" class="form-select">
                    <option value="">All Pipeline Stages</option>
                    <option value="Qualification" selected="@(ViewBag.CurrentStage == "Qualification")">Qualification</option>
                    <option value="Proposal" selected="@(ViewBag.CurrentStage == "Proposal")">Proposal</option>
                    <option value="Negotiation" selected="@(ViewBag.CurrentStage == "Negotiation")">Negotiation</option>
                    <option value="Won" selected="@(ViewBag.CurrentStage == "Won")">Won</option>
                    <option value="Lost" selected="@(ViewBag.CurrentStage == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-filter"></i> Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
            <div class="col text-end">
                <a asp-controller="Report" asp-action="ExportPipelineCsv" class="btn btn-outline-success btn-sm">
                    <i class="bi bi-file-earmark-excel"></i> Export CSV
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Opportunities Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Deal Name</th>
                        <th>Customer</th>
                        <th>Amount ($)</th>
                        <th>Probability</th>
                        <th>Weighted Value</th>
                        <th>Stage</th>
                        <th>Expected Close</th>
                        <th>Owner</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">No opportunities found matching your criteria.</td>
                        </tr>
                    }
                    @foreach (var opp in Model)
                    {
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@opp.OpportunityId" class="fw-bold text-dark text-decoration-none">
                                    @opp.OpportunityName
                                </a>
                            </td>
                            <td>
                                <span class="small fw-semibold">@(opp.Customer != null ? opp.Customer.CustomerName : "N/A")</span>
                            </td>
                            <td>
                                <span class="fw-bold text-dark">@opp.Amount.ToString("C0")</span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height: 6px; width: 60px;">
                                        <div class="progress-bar @(opp.Probability >= 80 ? "bg-success" : opp.Probability >= 50 ? "bg-primary" : "bg-warning")" style="width: @opp.Probability%"></div>
                                    </div>
                                    <span class="small fw-semibold">@opp.Probability%</span>
                                </div>
                            </td>
                            <td>
                                <span class="text-muted small">@opp.WeightedValue.ToString("C0")</span>
                            </td>
                            <td>
                                @if (opp.Stage == "Won")
                                {
                                    <span class="badge bg-success">Won</span>
                                }
                                else if (opp.Stage == "Lost")
                                {
                                    <span class="badge bg-danger">Lost</span>
                                }
                                else if (opp.Stage == "Negotiation")
                                {
                                    <span class="badge bg-warning text-dark">Negotiation</span>
                                }
                                else if (opp.Stage == "Proposal")
                                {
                                    <span class="badge bg-info text-dark">Proposal</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">Qualification</span>
                                }
                            </td>
                            <td>
                                <span class="small text-muted">@opp.ExpectedCloseDate.ToString("MMM dd, yyyy")</span>
                            </td>
                            <td>
                                <span class="small text-muted">@opp.AssignedTo</span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@opp.OpportunityId" class="btn btn-sm btn-outline-info" title="View Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@opp.OpportunityId" class="btn btn-sm btn-outline-primary" title="Edit Opportunity">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                {
                                    <form asp-action="Delete" asp-route-id="@opp.OpportunityId" method="post" class="d-inline" onsubmit="return confirm('Delete opportunity @opp.OpportunityName?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
