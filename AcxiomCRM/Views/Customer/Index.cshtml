@model IEnumerable<AcxiomCRM.Models.Entities.Customer>
@{
    ViewData["Title"] = "Customer Management";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-0"><i class="bi bi-people-fill text-primary me-2"></i>Customers</h3>
        <p class="text-muted small mb-0">Manage customer accounts, contacts, and account owners.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-pill px-3 shadow-sm">
        <i class="bi bi-person-plus-fill me-1"></i> Add Customer
    </a>
</div>

<!-- Search & Filter Card -->
<div class="card mb-4 border-0 shadow-sm">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-6 col-lg-4">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Search by name, code, email, phone, company..." value="@ViewBag.CurrentSearch" />
                </div>
            </div>
            <div class="col-md-4 col-lg-3">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Active" selected="@(ViewBag.CurrentStatus == "Active")">Active</option>
                    <option value="Inactive" selected="@(ViewBag.CurrentStatus == "Inactive")">Inactive</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-filter"></i> Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
            <div class="col text-end">
                <a asp-controller="Report" asp-action="ExportCustomersCsv" class="btn btn-outline-success btn-sm">
                    <i class="bi bi-file-earmark-excel"></i> Export CSV
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Customer Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Customer / Company</th>
                        <th>Contact Details</th>
                        <th>Location</th>
                        <th>Status</th>
                        <th>Owner</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No customers found matching your criteria.</td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-light text-dark border font-monospace">@item.CustomerCode</span>
                            </td>
                            <td>
                                <div class="fw-bold">@item.CustomerName</div>
                                <div class="small text-muted">@(string.IsNullOrWhiteSpace(item.CompanyName) ? "Individual" : item.CompanyName)</div>
                            </td>
                            <td>
                                <div><i class="bi bi-envelope text-muted me-1"></i>@item.Email</div>
                                <div class="small text-muted"><i class="bi bi-telephone text-muted me-1"></i>@item.Phone</div>
                            </td>
                            <td>
                                <span class="small">@item.City, @item.State</span>
                            </td>
                            <td>
                                @if (item.Status == "Active")
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary">Inactive</span>
                                }
                            </td>
                            <td>
                                <span class="small text-muted">@item.CreatedBy</span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.CustomerId" class="btn btn-sm btn-outline-info" title="View Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.CustomerId" class="btn btn-sm btn-outline-primary" title="Edit Customer">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                {
                                    <form asp-action="Delete" asp-route-id="@item.CustomerId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete customer @item.CustomerName?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Customer">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
