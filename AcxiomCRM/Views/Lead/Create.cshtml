@model AcxiomCRM.Models.ViewModels.LeadViewModel
@{
    ViewData["Title"] = "Create Lead";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0"><i class="bi bi-funnel text-primary me-2"></i>Create New Prospect Lead</h5>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to List</a>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="LeadName" class="form-label fw-semibold small">Lead Name <span class="text-danger">*</span></label>
                            <input asp-for="LeadName" class="form-control" placeholder="Contact or Lead Name" />
                            <span asp-validation-for="LeadName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CompanyName" class="form-label fw-semibold small">Company Name</label>
                            <input asp-for="CompanyName" class="form-control" placeholder="Prospect Company" />
                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold small">Email Address <span class="text-danger">*</span></label>
                            <input asp-for="Email" class="form-control" placeholder="prospect@company.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold small">Phone (10 Digits) <span class="text-danger">*</span></label>
                            <input asp-for="Phone" class="form-control" placeholder="9876543210" maxlength="10" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Source" class="form-label fw-semibold small">Lead Source <span class="text-danger">*</span></label>
                            <select asp-for="Source" class="form-select">
                                <option value="Website">Website</option>
                                <option value="Referral">Referral</option>
                                <option value="Cold Call">Cold Call</option>
                                <option value="Campaign">Campaign</option>
                                <option value="Partner">Partner</option>
                            </select>
                            <span asp-validation-for="Source" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label fw-semibold small">Status <span class="text-danger">*</span></label>
                            <select asp-for="Status" class="form-select">
                                <option value="New">New</option>
                                <option value="Contacted">Contacted</option>
                                <option value="Qualified">Qualified</option>
                                <option value="Unqualified">Unqualified</option>
                                <option value="Lost">Lost</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ExpectedValue" class="form-label fw-semibold small">Expected Value ($) <span class="text-danger">*</span></label>
                            <input asp-for="ExpectedValue" class="form-control" type="number" step="0.01" min="0" />
                            <span asp-validation-for="ExpectedValue" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="AssignedTo" class="form-label fw-semibold small">Assign to Rep (Email)</label>
                            <input asp-for="AssignedTo" class="form-control" placeholder="rep@acxiomcrm.com" />
                            <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="border-top mt-4 pt-3 d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Save Lead
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
