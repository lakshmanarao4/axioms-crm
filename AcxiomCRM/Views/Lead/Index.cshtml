@model IEnumerable<AcxiomCRM.Models.Entities.Lead>
@{
    ViewData["Title"] = "Lead Management";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-0"><i class="bi bi-funnel-fill text-primary me-2"></i>Leads Pipeline</h3>
        <p class="text-muted small mb-0">Capture, qualify, assign, and convert prospect leads.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-pill px-3 shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Add Lead
    </a>
</div>

<!-- Search & Filter Card -->
<div class="card mb-4 border-0 shadow-sm">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5 col-lg-4">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Search by name, company, email, phone..." value="@ViewBag.CurrentSearch" />
                </div>
            </div>
            <div class="col-md-4 col-lg-3">
                <select name="status" class="form-select">
                    <option value="">All Lead Statuses</option>
                    <option value="New" selected="@(ViewBag.CurrentStatus == "New")">New</option>
                    <option value="Contacted" selected="@(ViewBag.CurrentStatus == "Contacted")">Contacted</option>
                    <option value="Qualified" selected="@(ViewBag.CurrentStatus == "Qualified")">Qualified</option>
                    <option value="Converted" selected="@(ViewBag.CurrentStatus == "Converted")">Converted</option>
                    <option value="Lost" selected="@(ViewBag.CurrentStatus == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-filter"></i> Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Leads Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Lead Name / Company</th>
                        <th>Contact</th>
                        <th>Source</th>
                        <th>Expected Value</th>
                        <th>Status</th>
                        <th>Assigned Rep</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">No leads found matching your criteria.</td>
                        </tr>
                    }
                    @foreach (var lead in Model)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-light text-dark border font-monospace">@lead.LeadCode</span>
                            </td>
                            <td>
                                <div class="fw-bold">@lead.LeadName</div>
                                <div class="small text-muted">@lead.CompanyName</div>
                            </td>
                            <td>
                                <div class="small"><i class="bi bi-envelope text-muted me-1"></i>@lead.Email</div>
                                <div class="small text-muted"><i class="bi bi-telephone text-muted me-1"></i>@lead.Phone</div>
                            </td>
                            <td>
                                <span class="badge bg-secondary bg-opacity-10 text-secondary">@lead.Source</span>
                            </td>
                            <td>
                                <span class="fw-semibold text-dark">@lead.ExpectedValue.ToString("C0")</span>
                            </td>
                            <td>
                                @if (lead.Status == "New")
                                {
                                    <span class="badge bg-primary">New</span>
                                }
                                else if (lead.Status == "Contacted")
                                {
                                    <span class="badge bg-info text-dark">Contacted</span>
                                }
                                else if (lead.Status == "Qualified")
                                {
                                    <span class="badge bg-success">Qualified</span>
                                }
                                else if (lead.Status == "Converted")
                                {
                                    <span class="badge bg-purple" style="background-color: #8b5cf6; color: white;">Converted</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Lost</span>
                                }
                            </td>
                            <td>
                                <span class="small text-muted">@lead.AssignedTo</span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@lead.LeadId" class="btn btn-sm btn-outline-info" title="View Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (lead.Status != "Converted")
                                {
                                    <a asp-action="Edit" asp-route-id="@lead.LeadId" class="btn btn-sm btn-outline-primary" title="Edit Lead">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                }
                                @if (lead.Status == "Qualified")
                                {
                                    <form asp-action="Convert" asp-route-id="@lead.LeadId" method="post" class="d-inline" onsubmit="return confirm('Convert this Qualified lead into a Customer and active Opportunity?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-success" title="Convert to Customer">
                                            <i class="bi bi-arrow-repeat"></i> Convert
                                        </button>
                                    </form>
                                }
                                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                {
                                    <form asp-action="Delete" asp-route-id="@lead.LeadId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this lead?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Lead">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
