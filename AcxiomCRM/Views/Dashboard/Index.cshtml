@model AcxiomCRM.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Executive Dashboard";
    Layout = "_Layout";
}

<!-- Page Header & Filter -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1">Executive Sales Dashboard</h2>
        <p class="text-muted small mb-0">Real-time pipeline analytics, deal velocity, and follow-up activities.</p>
    </div>

    <!-- Date Filter Buttons -->
    <div class="btn-group shadow-sm" role="group">
        <a asp-action="Index" asp-route-dateFilter="All" class="btn btn-sm @(Model.DateFilter == "All" ? "btn-primary" : "btn-outline-secondary")">All Time</a>
        <a asp-action="Index" asp-route-dateFilter="Today" class="btn btn-sm @(Model.DateFilter == "Today" ? "btn-primary" : "btn-outline-secondary")">Today</a>
        <a asp-action="Index" asp-route-dateFilter="Week" class="btn btn-sm @(Model.DateFilter == "Week" ? "btn-primary" : "btn-outline-secondary")">This Week</a>
        <a asp-action="Index" asp-route-dateFilter="Month" class="btn btn-sm @(Model.DateFilter == "Month" ? "btn-primary" : "btn-outline-secondary")">This Month</a>
    </div>
</div>

<!-- KPI Cards Grid (8 Cards) -->
<div class="row g-3 mb-4">
    <!-- Total Customers -->
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 border-start border-4 border-primary">
            <div class="card-body p-3 d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Total Customers</span>
                    <h3 class="fw-bold text-dark mb-0 mt-1">@Model.TotalCustomers</h3>
                </div>
                <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-3">
                    <i class="bi bi-people-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Leads -->
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 border-start border-4 border-info">
            <div class="card-body p-3 d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Total Leads</span>
                    <h3 class="fw-bold text-dark mb-0 mt-1">@Model.TotalLeads</h3>
                    <span class="badge bg-info bg-opacity-10 text-info mt-1">@Model.OpenLeads Active</span>
                </div>
                <div class="p-3 bg-info bg-opacity-10 text-info rounded-3">
                    <i class="bi bi-funnel-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Opportunities -->
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 border-start border-4 border-purple" style="border-left-color: #8b5cf6 !important;">
            <div class="card-body p-3 d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Total Opportunities</span>
                    <h3 class="fw-bold text-dark mb-0 mt-1">@Model.TotalOpportunities</h3>
                    <span class="badge bg-purple bg-opacity-10 text-purple mt-1" style="color: #8b5cf6; background: #ede9fe;">@Model.OpenOpportunities Open</span>
                </div>
                <div class="p-3 rounded-3" style="background: #ede9fe; color: #8b5cf6;">
                    <i class="bi bi-graph-up-arrow fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Pipeline Value -->
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 border-start border-4 border-success">
            <div class="card-body p-3 d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Open Pipeline Value</span>
                    <h3 class="fw-bold text-success mb-0 mt-1">@Model.TotalPipelineValue.ToString("C0")</h3>
                    <span class="badge bg-success bg-opacity-10 text-success mt-1">Won: @Model.WonPipelineValue.ToString("C0")</span>
                </div>
                <div class="p-3 bg-success bg-opacity-10 text-success rounded-3">
                    <i class="bi bi-currency-dollar fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Open Opportunities -->
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 border-start border-4 border-primary">
            <div class="card-body p-3 d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Open Deals</span>
                    <h4 class="fw-bold text-dark mb-0 mt-1">@Model.OpenOpportunities</h4>
                </div>
                <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-3">
                    <i class="bi bi-hourglass-split fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Won Opportunities -->
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 border-start border-4 border-success">
            <div class="card-body p-3 d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Won Deals</span>
                    <h4 class="fw-bold text-success mb-0 mt-1">@Model.WonOpportunities</h4>
                </div>
                <div class="p-3 bg-success bg-opacity-10 text-success rounded-3">
                    <i class="bi bi-trophy-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Lost Opportunities -->
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 border-start border-4 border-danger">
            <div class="card-body p-3 d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Lost Deals</span>
                    <h4 class="fw-bold text-danger mb-0 mt-1">@Model.LostOpportunities</h4>
                </div>
                <div class="p-3 bg-danger bg-opacity-10 text-danger rounded-3">
                    <i class="bi bi-x-circle-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Conversion Ratio -->
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 border-start border-4 border-warning">
            <div class="card-body p-3 d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Win Conversion</span>
                    <h4 class="fw-bold text-dark mb-0 mt-1">
                        @((Model.WonOpportunities + Model.LostOpportunities) > 0 
                            ? Math.Round((double)Model.WonOpportunities / (Model.WonOpportunities + Model.LostOpportunities) * 100, 1) + "%" 
                            : "0%")
                    </h4>
                </div>
                <div class="p-3 bg-warning bg-opacity-10 text-warning rounded-3">
                    <i class="bi bi-pie-chart-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Dynamic Chart.js Analytics (Section 17.12) -->
<div class="row g-4 mb-4">
    <!-- Chart 1: Lead Status Breakdown (Doughnut) -->
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-bold"><i class="bi bi-funnel me-2 text-primary"></i>Lead Status Breakdown</span>
                <span class="badge bg-light text-secondary border">Chart.js</span>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center p-3">
                <div style="position: relative; width: 100%; height: 260px;">
                    <canvas id="leadStatusChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Chart 2: Pipeline Stage Value & Count (Bar) -->
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-bold"><i class="bi bi-bar-chart-line me-2 text-primary"></i>Opportunity Pipeline</span>
                <span class="badge bg-light text-secondary border">Stage Totals</span>
            </div>
            <div class="card-body p-3">
                <div style="position: relative; width: 100%; height: 260px;">
                    <canvas id="pipelineStageChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Chart 3: Monthly Sales Trend (Line/Area) -->
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-bold"><i class="bi bi-graph-up me-2 text-success"></i>Monthly Won Sales ($)</span>
                <span class="badge bg-light text-secondary border">6 Months</span>
            </div>
            <div class="card-body p-3">
                <div style="position: relative; width: 100%; height: 260px;">
                    <canvas id="monthlySalesChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Follow-Ups & Overdue Activities Grid -->
<div class="row g-4">
    <!-- Upcoming Follow-Ups -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-bold text-primary"><i class="bi bi-calendar-event me-2"></i>Upcoming Planned Follow-Ups</span>
                <a asp-controller="FollowUp" asp-action="Create" class="btn btn-sm btn-primary rounded-pill px-3">+ Schedule</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Target</th>
                                <th>Type</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.UpcomingFollowUps.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-3">No upcoming follow-ups scheduled.</td>
                                </tr>
                            }
                            @foreach (var f in Model.UpcomingFollowUps)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-semibold">@f.FollowUpDate.ToString("MMM dd, yyyy")</span>
                                    </td>
                                    <td>
                                        @(f.Customer != null ? f.Customer.CustomerName : f.Lead?.LeadName ?? "N/A")
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary">@f.FollowUpType</span>
                                    </td>
                                    <td>
                                        <form asp-controller="FollowUp" asp-action="Complete" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@f.FollowUpId" />
                                            <input type="hidden" name="remarks" value="Completed via Quick Action" />
                                            <button type="submit" class="btn btn-sm btn-outline-success py-0 px-2 rounded-pill">Done</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Overdue Follow-Ups -->
    <div class="col-lg-6">
        <div class="card h-100 border-danger border-opacity-25">
            <div class="card-header d-flex justify-content-between align-items-center bg-danger bg-opacity-10 text-danger">
                <span class="fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Overdue Follow-Ups</span>
                <span class="badge bg-danger">@Model.OverdueFollowUps.Count Overdue</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Due Date</th>
                                <th>Target</th>
                                <th>Remarks</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.OverdueFollowUps.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-success py-3"><i class="bi bi-check2-circle me-1"></i> Great job! No overdue follow-ups.</td>
                                </tr>
                            }
                            @foreach (var f in Model.OverdueFollowUps)
                            {
                                <tr>
                                    <td>
                                        <span class="text-danger fw-semibold">@f.FollowUpDate.ToString("MMM dd, yyyy")</span>
                                    </td>
                                    <td>
                                        @(f.Customer != null ? f.Customer.CustomerName : f.Lead?.LeadName ?? "N/A")
                                    </td>
                                    <td class="small text-muted text-truncate" style="max-width: 150px;">
                                        @f.Remarks
                                    </td>
                                    <td>
                                        <form asp-controller="FollowUp" asp-action="Complete" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@f.FollowUpId" />
                                            <input type="hidden" name="remarks" value="Completed overdue activity" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2 rounded-pill">Done</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // 1. Chart 1: Lead Status Doughnut Chart
    const ctxLead = document.getElementById('leadStatusChart').getContext('2d');
    new Chart(ctxLead, {
        type: 'doughnut',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusLabels)),
            datasets: [{
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusData)),
                backgroundColor: ['#3b82f6', '#06b6d4', '#10b981', '#ef4444', '#8b5cf6'],
                borderWidth: 2,
                borderColor: '#ffffff'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } }
            }
        }
    });

    // 2. Chart 2: Pipeline Stage Bar Chart
    const ctxPipe = document.getElementById('pipelineStageChart').getContext('2d');
    new Chart(ctxPipe, {
        type: 'bar',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PipelineStageLabels)),
            datasets: [{
                label: 'Stage Value ($)',
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PipelineStageValues)),
                backgroundColor: '#3b82f6',
                borderRadius: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: { callback: function(value) { return '$' + value.toLocaleString(); } }
                }
            }
        }
    });

    // 3. Chart 3: Monthly Sales Line Chart
    const ctxMonthly = document.getElementById('monthlySalesChart').getContext('2d');
    new Chart(ctxMonthly, {
        type: 'line',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyLabels)),
            datasets: [{
                label: 'Won Sales ($)',
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesData)),
                borderColor: '#10b981',
                backgroundColor: 'rgba(16, 185, 129, 0.1)',
                tension: 0.3,
                fill: true,
                pointRadius: 4,
                pointBackgroundColor: '#10b981'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: { callback: function(value) { return '$' + value.toLocaleString(); } }
                }
            }
        }
    });
</script>
}
