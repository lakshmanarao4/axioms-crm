@model AcxiomCRM.Models.ViewModels.FollowUpViewModel
@{
    ViewData["Title"] = "Schedule Follow-Up";
    Layout = "_Layout";
    var todayStr = DateTime.UtcNow.ToString("yyyy-MM-dd");
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0"><i class="bi bi-calendar-plus text-primary me-2"></i>Schedule CRM Follow-Up</h5>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to List</a>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label fw-semibold small">Target Customer</label>
                            <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select">
                                <option value="">-- Optional / None --</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LeadId" class="form-label fw-semibold small">Target Lead</label>
                            <select asp-for="LeadId" asp-items="ViewBag.Leads" class="form-select">
                                <option value="">-- Optional / None --</option>
                            </select>
                            <span asp-validation-for="LeadId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FollowUpDate" class="form-label fw-semibold small">Follow-Up Date <span class="text-danger">*</span></label>
                            <input asp-for="FollowUpDate" class="form-control" type="date" min="@todayStr" />
                            <div class="form-text small">Cannot be earlier than today for planned follow-ups.</div>
                            <span asp-validation-for="FollowUpDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FollowUpType" class="form-label fw-semibold small">Activity Type <span class="text-danger">*</span></label>
                            <select asp-for="FollowUpType" class="form-select">
                                <option value="Call">Phone Call</option>
                                <option value="Email">Email Outreach</option>
                                <option value="Meeting">In-Person / Online Meeting</option>
                                <option value="Demo">Product Demo</option>
                            </select>
                            <span asp-validation-for="FollowUpType" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-semibold small">Status <span class="text-danger">*</span></label>
                            <select asp-for="Status" class="form-select">
                                <option value="Planned">Planned</option>
                                <option value="Completed">Completed</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="AssignedTo" class="form-label fw-semibold small">Assigned Rep</label>
                            <input asp-for="AssignedTo" class="form-control" placeholder="rep@acxiomcrm.com" />
                            <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Remarks" class="form-label fw-semibold small">Remarks / Notes</label>
                            <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="Enter agenda, conversation notes or expected outcome..."></textarea>
                            <span asp-validation-for="Remarks" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="border-top mt-4 pt-3 d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                            <i class="bi bi-calendar-check me-1"></i> Save Follow-Up
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
