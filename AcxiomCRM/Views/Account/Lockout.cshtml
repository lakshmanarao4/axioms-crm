@{
    ViewData["Title"] = "Account Locked";
    Layout = "_Layout";
}

<div class="container text-center my-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-danger rounded-4 p-4 text-center">
                <div class="display-3 text-danger mb-3">
                    <i class="bi bi-shield-x"></i>
                </div>
                <h2 class="text-danger fw-bold">Account Locked Out</h2>
                <p class="text-muted mt-2">
                    This account has been temporarily locked due to <strong>5 consecutive failed login attempts</strong> in accordance with the AcxiomCRM Enterprise Security Policy.
                </p>
                <div class="alert alert-warning small text-start my-3">
                    <i class="bi bi-info-circle-fill me-1"></i> The lockout duration is configured for <strong>15 minutes</strong>. An authorized system administrator can unlock this account immediately from the User Management console.
                </div>
                <div>
                    <a asp-action="Login" class="btn btn-primary px-4 fw-semibold">
                        <i class="bi bi-arrow-left"></i> Return to Login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
