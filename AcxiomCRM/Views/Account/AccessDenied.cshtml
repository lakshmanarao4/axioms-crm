@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}

<div class="container text-center my-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-warning rounded-4 p-4 text-center">
                <div class="display-3 text-warning mb-3">
                    <i class="bi bi-shield-slash"></i>
                </div>
                <h2 class="text-dark fw-bold">403 — Access Denied</h2>
                <p class="text-muted mt-2">
                    You do not have the necessary role permissions or privileges to access this CRM resource.
                </p>
                <div class="alert alert-light border small text-start my-3">
                    <strong>Role Policy:</strong> Access to user management, system audit logs, and global administrative actions requires the <strong>Admin</strong> or <strong>Manager</strong> role.
                </div>
                <div>
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary px-4 fw-semibold">
                        <i class="bi bi-grid-1x2"></i> Return to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
