@model IEnumerable<AcxiomCRM.Models.Entities.Activity>
@{
    ViewData["Title"] = "Activity Log";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-0"><i class="bi bi-list-task text-primary me-2"></i>Sales Activities</h3>
        <p class="text-muted small mb-0">Record and review customer interactions, discovery calls, and meetings.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-pill px-3 shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Log Activity
    </a>
</div>

<!-- Filters -->
<div class="card mb-4 border-0 shadow-sm">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5 col-lg-4">
                <input type="text" name="search" class="form-control" placeholder="Search subject or description..." value="@ViewBag.CurrentSearch" />
            </div>
            <div class="col-md-3 col-lg-3">
                <select name="type" class="form-select">
                    <option value="">All Activity Types</option>
                    <option value="Call" selected="@(ViewBag.CurrentType == "Call")">Call</option>
                    <option value="Meeting" selected="@(ViewBag.CurrentType == "Meeting")">Meeting</option>
                    <option value="Email" selected="@(ViewBag.CurrentType == "Email")">Email</option>
                    <option value="Task" selected="@(ViewBag.CurrentType == "Task")">Task</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-filter"></i> Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Subject & Notes</th>
                        <th>Target Record</th>
                        <th>Owner</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No sales activities recorded.</td>
                        </tr>
                    }
                    @foreach (var act in Model)
                    {
                        <tr>
                            <td class="small fw-semibold">@act.ActivityDate.ToString("MMM dd, yyyy HH:mm")</td>
                            <td>
                                @if (act.ActivityType == "Call")
                                {
                                    <span class="badge bg-primary bg-opacity-10 text-primary"><i class="bi bi-telephone me-1"></i>Call</span>
                                }
                                else if (act.ActivityType == "Meeting")
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success"><i class="bi bi-people me-1"></i>Meeting</span>
                                }
                                else if (act.ActivityType == "Email")
                                {
                                    <span class="badge bg-info bg-opacity-10 text-info"><i class="bi bi-envelope me-1"></i>Email</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary"><i class="bi bi-check2-square me-1"></i>Task</span>
                                }
                            </td>
                            <td>
                                <div class="fw-bold">@act.Subject</div>
                                <div class="small text-muted text-truncate" style="max-width: 300px;">@act.Description</div>
                            </td>
                            <td>
                                @if (act.Customer != null)
                                {
                                    <span class="small fw-semibold text-primary"><i class="bi bi-building me-1"></i>@act.Customer.CustomerName</span>
                                }
                                else if (act.Lead != null)
                                {
                                    <span class="small fw-semibold text-info"><i class="bi bi-funnel me-1"></i>@act.Lead.LeadName</span>
                                }
                                else
                                {
                                    <span class="text-muted small">General</span>
                                }
                            </td>
                            <td><span class="small text-muted">@act.AssignedTo</span></td>
                            <td><span class="badge bg-success">@act.Status</span></td>
                            <td class="text-end">
                                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                {
                                    <form asp-action="Delete" asp-route-id="@act.ActivityId" method="post" class="d-inline" onsubmit="return confirm('Delete this activity record?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
